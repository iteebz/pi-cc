{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["src/**/*.ts", "tests/**/*.mjs", "diag/**/*.mjs"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noParameterAssign": "off",
				"useNodejsImportProtocol": "off",
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noUselessSwitchCase": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off"
			}
		}
	}
}
